# Copy to .env (never commit .env). Placeholders only — no real secrets here.

# Development database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/donjaicheck?schema=public"

# Test database — must end in _test and differ from DATABASE_URL.
# Tests DELETE all rows in this database. In CI (CI=true) DATABASE_URL is used.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/donjaicheck_test?schema=public"

# HTTP port (Cloud Run sets PORT itself)
PORT=3000

# development | production | test
NODE_ENV=development

# Session lifetime in hours (NFR-03)
SESSION_TTL_HOURS=8

# bcrypt cost factor, minimum 10 (NFR-01)
BCRYPT_COST=10

# Seed passwords (D-06). Required by `npm run prisma:seed`. Use your own values locally;
# in the cloud they come from Secret Manager.
ADMIN_PASSWORD="change-me-owner-1"
DEMO_USER_PASSWORD="change-me-customer-1"

# Create the sample surveys and demo respondents (true locally; optional in the cloud)
SEED_DEMO_DATA=true
